[branch]
  sort = -committerdate
[diff]
  algorithm = histogram
  colorMobed = plain
  renames = true
[github]
  user = re1
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  autoSetupRemote = true
[rebase]
  autoStash = true
  updateRefs = true
[tag]
  sort = version:refname

[include]
  path = ~/.config/delta/.gitconfig
